{
  "name": "base-rescue-bot",
  "version": "1.0.0",
  "description": "Flashbots-style bundle bot to rescue airdropped tokens from a compromised wallet on Base chain",
  "main": "bot.js",
  "type": "module",
  "scripts": {
    "start":         "node bot.js",
    "watch":         "node bot.js --watch",
    "monitor":       "node bot.js --monitor-only",
    "simulate":      "node bot.js --simulate",
    "check":         "node checkBalances.js",
    "dryrun":        "node dryRun.js",
    "calldata":      "node calldataGen.js",
    "status":        "node checkBundle.js"
  },
  "dependencies": {
    "chalk":   "^5.3.0",
    "dotenv":  "^16.4.5",
    "ethers":  "^6.13.2",
    "ora":     "^8.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "MIT"
}
