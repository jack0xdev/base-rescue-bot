# ============================================================
#  BASE RESCUE BOT — Environment Configuration
# ============================================================

# --- Wallet Keys ---
# Your SAFE wallet private key (receives rescued tokens after the sweep)
SAFE_WALLET_PRIVATE_KEY=0xYOUR_SAFE_WALLET_PRIVATE_KEY

# The HACKED / compromised wallet private key
# You must still have the private key to sign tx from it
HACKED_WALLET_PRIVATE_KEY=0xYOUR_HACKED_WALLET_PRIVATE_KEY

# SPONSOR FEES WALLET (optional but recommended)
# A dedicated wallet used ONLY to pay gas for the hacked wallet (Tx1: ETH fund).
# Keeping this separate from the safe wallet limits exposure:
#   - Safe wallet  → only receives rescued tokens (never signs gas-funding tx)
#   - Sponsor wallet → only holds gas ETH (~0.001 ETH), never holds rescued assets
# If not set, falls back to SAFE_WALLET_PRIVATE_KEY (original behaviour).
# SPONSOR_FEES_WALLET_PRIVATE_KEY=0xYOUR_SPONSOR_FEES_WALLET_PRIVATE_KEY

# --- Airdrop Contract ---
# The contract address that holds the claimable airdrop
AIRDROP_CONTRACT_ADDRESS=0xAIRDROP_CONTRACT_ADDRESS

# The calldata (hex) for the claim() function on the airdrop contract
# e.g., "0x4e71d92d" for a standard claim(), or ABI-encoded with proof/index
# Generate this from the airdrop contract ABI + your claim parameters
AIRDROP_CLAIM_CALLDATA=0x4e71d92d

# The ERC-20 token contract address of the airdropped token
AIRDROP_TOKEN_ADDRESS=0xTOKEN_CONTRACT_ADDRESS

# --- RPC & Relay ---
# Public Base RPC for monitoring/querying (can use a free provider)
BASE_RPC_URL=https://mainnet.base.org

# Private bundle relay endpoint for Base chain (Flashbots Protect or equivalent)
# Options:
#   Flashbots Protect (Base): https://rpc-base.flashbots.net
#   BloXroute (Base):         https://api.blxrbdn.com  (needs BloXroute API key)
#   Titanium (Base builder):  https://rpc.titanbuilder.xyz
BUNDLE_RELAY_URL=https://rpc-base.flashbots.net

# --- Gas Strategy ---
# Max priority fee per gas in Gwei (tip to validator, e.g., 5)
MAX_PRIORITY_FEE_GWEI=5

# Max fee per gas cap in Gwei (baseFee + priority, e.g., 20)
MAX_FEE_GWEI=20

# Multiplier on top of current base fee for safety (e.g., 1.5 = 50% buffer)
BASE_FEE_MULTIPLIER=1.5

# --- ETH to send for gas ---
# How much ETH (in Ether) to send from Safe → Hacked wallet to cover gas
# Must be enough to pay for Tx2 + Tx3 at your max gas price
ETH_GAS_BUFFER=0.001

# --- Monitoring ---
# How often to poll claim eligibility, in milliseconds (default: 15s = one Base block)
POLL_INTERVAL_MS=15000

# Max number of bundle submission attempts before stopping
MAX_BUNDLE_ATTEMPTS=10

# How many blocks ahead to target for bundle inclusion
BLOCKS_AHEAD_TARGET=2

# --- Optional: BloXroute API Key (only needed if using BloXroute relay) ---
# BLOXROUTE_API_KEY=YOUR_BLOXROUTE_API_KEY

# --- Chain ID ---
# Base Mainnet = 8453 | Base Sepolia Testnet = 84532
CHAIN_ID=8453
